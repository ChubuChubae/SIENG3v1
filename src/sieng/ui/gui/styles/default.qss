/* SIENG3 - Midnight Cat
 *
 * #0A0B10  ink        the window itself, and the inside of every input
 * #15294A  navy       cards and raised surfaces, sitting just above the ink
 * #0168B3  blue       the primary action, and only that
 * #7B5C9D  violet     secondary actions and the drag state
 * #48A1DC  sky        focus, hover, links, and anything asking to be looked at
 * #F5F9FC  paper      text
 *
 * Two colours are not from the palette and are marked where they appear: an amber and a
 * red for the capacity warning and the refusal. The palette has no warm end, and a line
 * that says a payload will not fit has to read as a refusal rather than as decoration.
 *
 * Depth comes from translucency rather than from more colours. A card is #15294A at 45%
 * over the ink, so the two greys in the palette do the work of five.
 *
 * The state chip is gone. It mixed an instruction, a running state and a page mode into
 * one word, so what replaced it is a session bar that says one thing, and progress and
 * outcome next to the button that causes them.
 *
 * One border level, not four. A card has a border; the input inside it has a border; the
 * things between them do not. Nesting outlines is what made the old screens read as a
 * form rather than as an application.
 *
 * Type sizes, once, so they stay a hierarchy:
 *   page title 25 · card title 15 · body 13 · label 11 · hint 11
 */

/* ---- window ------------------------------------------------------------ */

#rootWidget {
    background-color: #0A0B10;
    color: #F5F9FC;
    border: 1px solid #15294A;
}

QWidget {
    font-family: "Segoe UI", "Inter", system-ui, sans-serif;
    font-size: 13px;
    color: #F5F9FC;
}

/* ---- title bar --------------------------------------------------------- */

#titleBarContainer {
    background-color: #0A0B10;
    border-bottom: 1px solid #15294A;
}

#logoMark {
    background-color: #0168B3;
    border-radius: 8px;
    color: #F5F9FC;
    font-size: 15px;
    font-weight: 700;
}

#appTitle {
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 3px;
    color: #F5F9FC;
}

#appSubtitle {
    font-size: 10px;
    letter-spacing: 1px;
    color: rgba(245, 249, 252, 0.45);
}

#windowControlBtn, #windowCloseBtn {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    color: rgba(245, 249, 252, 0.65);
    font-size: 13px;
}

#windowControlBtn:hover {
    background-color: rgba(72, 161, 220, 0.16);
    color: #F5F9FC;
}

#windowCloseBtn:hover {
    /* Red, not in the palette. Closing is the one control that should not look inviting. */
    background-color: #E0555F;
    color: #F5F9FC;
}

/* ---- sidebar ----------------------------------------------------------- */

#sidebarContainer {
    background-color: #0A0B10;
    border-right: 1px solid #15294A;
}

#sidebarSectionLabel {
    color: rgba(245, 249, 252, 0.35);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    padding: 14px 10px 4px 10px;
}

#sidebarButton {
    background-color: transparent;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 8px;
    color: rgba(245, 249, 252, 0.62);
    font-size: 13px;
    font-weight: 500;
    padding: 11px 12px;
    text-align: left;
}

#sidebarButton:hover {
    background-color: rgba(72, 161, 220, 0.10);
    color: #F5F9FC;
}

#sidebarButton:checked {
    background-color: #15294A;
    border-left: 3px solid #48A1DC;
    color: #F5F9FC;
    font-weight: 600;
}

#sidebarFooterName {
    color: rgba(245, 249, 252, 0.55);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    padding: 0 10px;
}

#sidebarFooterLine {
    color: rgba(245, 249, 252, 0.28);
    font-size: 10px;
    padding: 0 10px;
}

/* ---- page header ------------------------------------------------------- */

#pageTitle {
    color: #F5F9FC;
    font-size: 25px;
    font-weight: 700;
}

#pageSubtitle {
    color: rgba(245, 249, 252, 0.55);
    font-size: 13px;
}

/* ---- session bar ------------------------------------------------------- */

#sessionBar {
    background-color: rgba(21, 41, 74, 0.55);
    border-bottom: 1px solid rgba(72, 161, 220, 0.16);
}

#sessionBar[loaded="true"] { border-bottom: 1px solid rgba(1, 104, 179, 0.65); }

#sessionName  { color: rgba(245, 249, 252, 0.55); font-size: 12px; font-weight: 600; }
#sessionWhere { color: rgba(245, 249, 252, 0.30); font-size: 10px; }

#sessionBar[loaded="true"] #sessionName { color: #F5F9FC; }

/* ---- capacity meter ---------------------------------------------------- */

#capacityMeter {
    background-color: rgba(72, 161, 220, 0.07);
    border: 1px solid rgba(72, 161, 220, 0.20);
    border-radius: 9px;
}

#capacityHeadline { color: #48A1DC; font-size: 12px; font-weight: 600; }
#capacityNote     { color: rgba(245, 249, 252, 0.50); font-size: 11px; }

QProgressBar#capacityBar {
    background-color: rgba(10, 11, 16, 0.8);
    border: none;
    border-radius: 3px;
}

QProgressBar#capacityBar::chunk { background-color: #0168B3; border-radius: 3px; }

/* Amber, added. Past seventy percent the number is the thing detectors read best. */
#capacityMeter[capacityState="warn"] {
    background-color: rgba(232, 163, 61, 0.08);
    border-color: rgba(232, 163, 61, 0.45);
}

#capacityHeadline[capacityState="warn"] { color: #E8A33D; }
QProgressBar#capacityBar[capacityState="warn"]::chunk { background-color: #E8A33D; }

/* Red, added. This one is a refusal and has to read as one. */
#capacityMeter[capacityState="over"] {
    background-color: rgba(224, 85, 95, 0.08);
    border-color: rgba(224, 85, 95, 0.50);
}

#capacityHeadline[capacityState="over"] { color: #E0555F; }
QProgressBar#capacityBar[capacityState="over"]::chunk { background-color: #E0555F; }

/* A disabled button must say what it is waiting for, in the page, not in a tooltip. */
#missingLabel {
    color: rgba(245, 249, 252, 0.55);
    font-size: 12px;
    padding: 2px 0;
}

#formCheck { color: rgba(245, 249, 252, 0.82); font-size: 12px; spacing: 9px; }

#formCheck::indicator {
    border: 1px solid rgba(72, 161, 220, 0.45);
    border-radius: 4px;
    height: 15px;
    width: 15px;
}

#formCheck::indicator:checked {
    background-color: #0168B3;
    border-color: #0168B3;
}

QProgressBar#workProgress {
    background-color: rgba(10, 11, 16, 0.85);
    border: 1px solid rgba(72, 161, 220, 0.20);
    border-radius: 9px;
    color: rgba(245, 249, 252, 0.75);
    font-size: 10px;
    text-align: center;
}

QProgressBar#workProgress::chunk {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
                                      stop: 0 #0168B3, stop: 1 #48A1DC);
    border-radius: 8px;
}

/* ---- cards ------------------------------------------------------------- */

#card {
    background-color: rgba(21, 41, 74, 0.45);
    border: 1px solid rgba(72, 161, 220, 0.16);
    border-radius: 12px;
}

#cardTitle {
    color: #F5F9FC;
    font-size: 15px;
    font-weight: 600;
}

#cardSubtitle {
    color: rgba(245, 249, 252, 0.50);
    font-size: 12px;
}

#sectionLabel {
    color: #48A1DC;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
}

#mainLabel { color: #F5F9FC; font-size: 15px; font-weight: 600; }
#subLabel  { color: rgba(245, 249, 252, 0.72); font-size: 13px; }
#hintLabel { color: rgba(245, 249, 252, 0.42); font-size: 11px; }

#formLabel {
    color: rgba(245, 249, 252, 0.78);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.4px;
    padding-top: 6px;
}

#requiredMark { color: #48A1DC; font-size: 11px; font-weight: 700; }

/* A line the user should read once, not a warning. Left rule, no box. */
#noticeLabel {
    border-left: 2px solid rgba(72, 161, 220, 0.55);
    color: rgba(245, 249, 252, 0.62);
    font-size: 12px;
    padding: 2px 0 2px 12px;
}

/* ---- disclosure -------------------------------------------------------- */

#disclosureToggle {
    background-color: transparent;
    border: none;
    color: rgba(245, 249, 252, 0.62);
    font-size: 12px;
    font-weight: 600;
    padding: 8px 0;
    text-align: left;
}

#disclosureToggle:hover  { color: #48A1DC; }
#disclosureToggle:checked { color: #F5F9FC; }

#disclosureBody {
    border-left: 1px solid rgba(72, 161, 220, 0.16);
    padding-left: 14px;
}

/* ---- detail table ------------------------------------------------------ */

#detailTable {
    background-color: rgba(10, 11, 16, 0.55);
    border: 1px solid rgba(72, 161, 220, 0.12);
    border-radius: 8px;
}

#detailKey   { color: rgba(245, 249, 252, 0.40); font-size: 11px; }
#detailValue { color: rgba(245, 249, 252, 0.82); font-size: 12px; }

/* ---- status line ------------------------------------------------------- */

#statusLabel {
    background-color: transparent;
    color: rgba(245, 249, 252, 0.72);
    font-size: 12px;
}

#statusLabel[tone="good"]   { color: #48A1DC; }
#statusLabel[tone="bad"]    { color: #E0555F; }  /* red, added */
#statusLabel[tone="busy"]   { color: #7B5C9D; }

/* ---- inputs ------------------------------------------------------------ */

#formInput, QLineEdit, QComboBox, QDoubleSpinBox, QSpinBox, QPlainTextEdit {
    background-color: #0A0B10;
    border: 1px solid rgba(72, 161, 220, 0.22);
    border-radius: 8px;
    color: #F5F9FC;
    min-height: 22px;
    padding: 9px 11px;
    selection-background-color: #0168B3;
    selection-color: #F5F9FC;
}

#formInput:hover, QLineEdit:hover, QComboBox:hover,
QDoubleSpinBox:hover, QSpinBox:hover {
    border-color: rgba(72, 161, 220, 0.45);
}

#formInput:focus, QLineEdit:focus, QComboBox:focus,
QDoubleSpinBox:focus, QSpinBox:focus, QPlainTextEdit:focus {
    border-color: #48A1DC;
}

QLineEdit::placeholder { color: rgba(245, 249, 252, 0.30); }

QComboBox::drop-down { border: none; width: 26px; }

QComboBox::down-arrow {
    image: url(:/none);
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid rgba(245, 249, 252, 0.55);
    width: 0;
    height: 0;
    margin-right: 10px;
}

QComboBox QAbstractItemView {
    background-color: #15294A;
    border: 1px solid rgba(72, 161, 220, 0.30);
    border-radius: 8px;
    outline: none;
    padding: 4px;
    selection-background-color: #0168B3;
}

QDoubleSpinBox::up-button, QSpinBox::up-button,
QDoubleSpinBox::down-button, QSpinBox::down-button {
    background-color: rgba(72, 161, 220, 0.12);
    border: none;
    width: 20px;
}

QDoubleSpinBox::up-button:hover, QSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover, QSpinBox::down-button:hover {
    background-color: rgba(72, 161, 220, 0.28);
}

/* ---- buttons ----------------------------------------------------------- */

QPushButton#PrimaryActionBtn {
    background-color: #0168B3;
    border: none;
    border-radius: 10px;
    color: #F5F9FC;
    font-size: 14px;
    font-weight: 600;
    padding: 12px 30px;
}

QPushButton#PrimaryActionBtn:hover   { background-color: #48A1DC; }
QPushButton#PrimaryActionBtn:pressed { background-color: #15294A; }

QPushButton#PrimaryActionBtn:disabled {
    background-color: rgba(1, 104, 179, 0.22);
    color: rgba(245, 249, 252, 0.32);
}

QPushButton#SecondaryBtn {
    background-color: transparent;
    border: 1px solid #7B5C9D;
    border-radius: 10px;
    color: #F5F9FC;
    font-size: 13px;
    font-weight: 500;
    padding: 11px 22px;
}

QPushButton#SecondaryBtn:hover {
    background-color: rgba(123, 92, 157, 0.20);
    border-color: #48A1DC;
}

QPushButton#SecondaryBtn:pressed { background-color: rgba(123, 92, 157, 0.35); }

QPushButton#SecondaryBtn:disabled {
    border-color: rgba(123, 92, 157, 0.30);
    color: rgba(245, 249, 252, 0.30);
}

QPushButton#SmallBtn {
    background-color: rgba(72, 161, 220, 0.10);
    border: 1px solid rgba(72, 161, 220, 0.22);
    border-radius: 7px;
    color: rgba(245, 249, 252, 0.82);
    font-size: 12px;
    padding: 7px 14px;
}

QPushButton#SmallBtn:hover {
    background-color: rgba(72, 161, 220, 0.20);
    border-color: #48A1DC;
    color: #F5F9FC;
}

QPushButton#LinkBtn {
    background-color: transparent;
    border: none;
    color: #48A1DC;
    font-size: 12px;
    padding: 6px 2px;
    text-align: left;
}

QPushButton#LinkBtn:hover { color: #F5F9FC; }

/* ---- segmented control ------------------------------------------------- */

QPushButton#segmentBtn {
    background-color: rgba(10, 11, 16, 0.6);
    border: 1px solid rgba(72, 161, 220, 0.20);
    border-radius: 8px;
    color: rgba(245, 249, 252, 0.62);
    font-size: 13px;
    font-weight: 500;
    padding: 9px 10px;
}

QPushButton#segmentBtn:hover {
    border-color: rgba(72, 161, 220, 0.50);
    color: #F5F9FC;
}

QPushButton#segmentBtn:checked {
    background-color: rgba(1, 104, 179, 0.30);
    border-color: #0168B3;
    color: #F5F9FC;
    font-weight: 600;
}

/* ---- drop zone --------------------------------------------------------- */

QFrame#fileDropZone {
    background-color: rgba(10, 11, 16, 0.55);
    border: 1px dashed rgba(72, 161, 220, 0.30);
    border-radius: 10px;
}

QFrame#fileDropZone[hasFile="false"]:hover {
    background-color: rgba(72, 161, 220, 0.06);
    border-color: #48A1DC;
}

QFrame#fileDropZone[isDragging="true"] {
    background-color: rgba(123, 92, 157, 0.14);
    border: 1px dashed #7B5C9D;
}

QFrame#fileDropZone[hasFile="true"] {
    background-color: rgba(1, 104, 179, 0.10);
    border: 1px solid rgba(1, 104, 179, 0.75);
}

#dropPrompt { color: rgba(245, 249, 252, 0.80); font-size: 13px; font-weight: 500; }
#dropAction { color: #48A1DC; font-size: 12px; }
#dropHint   { color: rgba(245, 249, 252, 0.34); font-size: 11px; }

#fileThumb {
    background-color: rgba(21, 41, 74, 0.8);
    border-radius: 8px;
}

#fileInfoName   { color: #F5F9FC; font-size: 13px; font-weight: 600; }
#fileInfoDetail { color: rgba(245, 249, 252, 0.45); font-size: 11px; }

/* ---- save picker ------------------------------------------------------- */

QFrame#savePicker {
    background-color: rgba(10, 11, 16, 0.55);
    border: 1px solid rgba(72, 161, 220, 0.22);
    border-radius: 8px;
}

QFrame#savePicker[hasPath="true"] { border-color: rgba(1, 104, 179, 0.75); }

#savePickerPath { color: rgba(245, 249, 252, 0.45); font-size: 12px; }

QFrame#savePicker[hasPath="true"] #savePickerPath { color: #F5F9FC; }

/* ---- secret box -------------------------------------------------------- */

#payloadTextArea {
    background-color: #0A0B10;
    border: 1px solid #7B5C9D;
    border-radius: 8px;
    color: #F5F9FC;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 12px;
    padding: 10px;
}

/* ---- scrolling --------------------------------------------------------- */

#pageScrollArea, QScrollArea { background-color: transparent; border: none; }
QScrollArea > QWidget > QWidget { background-color: transparent; }

QScrollBar:vertical {
    background: transparent;
    border: none;
    margin: 4px 2px 4px 0;
    width: 10px;
}

QScrollBar::handle:vertical {
    background: rgba(72, 161, 220, 0.22);
    border-radius: 5px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover { background: rgba(72, 161, 220, 0.45); }

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
    border: none;
    height: 0;
}

QScrollBar:horizontal { height: 0; }

/* ---- misc -------------------------------------------------------------- */

QToolTip {
    background-color: #15294A;
    border: 1px solid #48A1DC;
    border-radius: 6px;
    color: #F5F9FC;
    padding: 6px 9px;
}

#divider {
    background-color: rgba(72, 161, 220, 0.14);
    border: none;
    max-height: 1px;
    min-height: 1px;
}
